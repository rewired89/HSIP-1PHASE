# Copy to .env. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# 64 hex chars. Encrypts every organization's signing key at rest.
# BACK THIS UP. Without it, existing signing keys are unrecoverable.
HSP_MASTER_KEY=
# 24+ chars. Enables the operator console at /operator. Leave empty to disable it.
HSP_OPERATOR_KEY=
HSP_PUBLIC_URL=https://prove.example.com
# false = invitation-only (existing orgs invite people; no self-service sign-up)
HSP_SIGNUP=true
# Header your proxy sets to the real client IP (Fly.io: fly-client-ip). Used for per-IP rate limits.
# Leave unset when clients connect directly; set it only when the proxy overwrites that header.
# HSP_CLIENT_IP_HEADER=fly-client-ip
# true = commit batch roots to Bitcoin via public OpenTimestamps calendars (needs outbound HTTPS)
HSP_OTS=false

# Outbound email (any Resend-compatible API). Leave unset to keep copy-paste invite links.
# HSP_EMAIL_API_KEY=
# HSP_EMAIL_FROM=HSIP <noreply@yourdomain.com>
# HSP_EMAIL_API_URL=https://api.resend.com

# Stripe billing. Create two recurring prices (Team, Business), then add a webhook
# endpoint at {HSP_PUBLIC_URL}/v1/stripe/webhook for checkout.session.completed,
# customer.subscription.updated and customer.subscription.deleted.
# HSP_STRIPE_SECRET_KEY=sk_live_...
# HSP_STRIPE_WEBHOOK_SECRET=whsec_...
# HSP_STRIPE_PRICE_TEAM=price_...
# HSP_STRIPE_PRICE_BUSINESS=price_...
