# Copy to .env. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# 64 hex chars. Encrypts every organization's signing key at rest.
# BACK THIS UP. Without it, existing signing keys are unrecoverable.
HSP_MASTER_KEY=
# 24+ chars. Enables the operator console at /operator. Leave empty to disable it.
HSP_OPERATOR_KEY=
HSP_PUBLIC_URL=https://prove.example.com
# false = invitation-only (existing orgs invite people; no self-service sign-up)
HSP_SIGNUP=true
# true = commit batch roots to Bitcoin via public OpenTimestamps calendars (needs outbound HTTPS)
HSP_OTS=false
