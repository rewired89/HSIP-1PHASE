# HSIP API Server — Multi-stage build
FROM rust:1.87-slim AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Cache dependencies
COPY Cargo.toml Cargo.lock ./
COPY crates/hsip-core/Cargo.toml     crates/hsip-core/Cargo.toml
COPY crates/hsip-api/Cargo.toml      crates/hsip-api/Cargo.toml
COPY crates/hsip-session/Cargo.toml  crates/hsip-session/Cargo.toml
COPY crates/hsip-net/Cargo.toml      crates/hsip-net/Cargo.toml
COPY crates/hsip-reputation/Cargo.toml  crates/hsip-reputation/Cargo.toml
COPY crates/hsip-auth/Cargo.toml     crates/hsip-auth/Cargo.toml
COPY crates/hsip-common/Cargo.toml   crates/hsip-common/Cargo.toml
COPY crates/hsip-regenerative/Cargo.toml   crates/hsip-regenerative/Cargo.toml
COPY crates/hsip-telemetry-guard/Cargo.toml crates/hsip-telemetry-guard/Cargo.toml
COPY crates/hsip-integration-sdk/Cargo.toml crates/hsip-integration-sdk/Cargo.toml

# Build source
COPY crates/ crates/
RUN cargo build --release -p hsip-api

# Runtime image
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/target/release/hsip-api /usr/local/bin/hsip-api

RUN useradd -r -s /bin/false hsip
RUN mkdir -p /data && chown hsip:hsip /data

USER hsip

ENV PORT=3000
ENV HSIP_DB_PATH=/data/hsip_api.db
ENV RUST_LOG=hsip_api=info

VOLUME ["/data"]
EXPOSE 3000

CMD ["hsip-api"]
